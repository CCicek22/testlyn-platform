{
  "name": "@testlyn/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types for Testlyn (hand-authored; TODO: regenerate from OpenAPI spec)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
