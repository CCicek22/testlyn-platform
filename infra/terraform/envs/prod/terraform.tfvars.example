# Copy to terraform.tfvars and fill in real values before running terraform apply.
# NEVER commit terraform.tfvars — it is gitignored.

gcp_project_id     = "example-project"
gcp_project_number = "123456789012"   # numeric project number, not the string ID
region             = "us-central1"
env                = "prod"

# Postgres (live: self-hosted PgBouncer on db-vm VM 10.0.0.5)
# NOTE: the live DB password is NOT set here. It lives in GCP Secret Manager
# (secret `testlyn-db-password`) and is injected into testlyn-api by infra-repo.
# Do NOT put a real password in this file or in terraform.tfvars.
# `db_password` is a legacy/unused var (cloud_sql torn down) — leave it unset.
# Optional overrides — defaults in variables.tf point at live infra.
# db_host   = "10.0.0.5"
# redis_url = "redis://10.0.0.5:6379/0"

# Container images (filled in by CI after build)
api_image    = "us-central1-docker.pkg.dev/example-project/testlyn/api:latest"
web_image    = "us-central1-docker.pkg.dev/example-project/testlyn/web:latest"
engine_image = "us-central1-docker.pkg.dev/example-project/testlyn/engine:latest"

# Billing (for budget alerts — find in GCP Console > Billing)
billing_account_id = "XXXXXX-XXXXXX-XXXXXX"

# GitHub Actions Workload Identity Federation service account
# Created separately; set to "" to skip WIF binding
github_wif_sa_email = ""
