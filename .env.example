# --- GCP ---
GCP_PROJECT_ID=example-project-prod            # TODO: replace with real Example Co project ID at first apply
GCP_REGION=us-central1
GCP_BQ_DATASET=testlyn_metrics
GCS_SCRIPTS_BUCKET=testlyn-prod-scripts
GCS_RESULTS_BUCKET=testlyn-prod-results
GCS_REPORTS_BUCKET=testlyn-prod-reports
GCS_SPOOL_BUCKET=testlyn-prod-spool

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=postgresql+asyncpg://testlyn:testlyn@localhost:5432/testlyn
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
DEV_AUTH_BYPASS=true                  # local dev only, skips Identity Platform JWT verify

# --- Identity Platform / Firebase Auth ---
FIREBASE_PROJECT_ID=                  # TODO: set after IdP enable
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# --- Stripe (stubbed in Phase 1 vertical slice) ---
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- SendGrid (stubbed) ---
SENDGRID_API_KEY=SG.PLACEHOLDER
SENDGRID_FROM_EMAIL=noreply@testlyn.io

# --- Gemini / Vertex AI (stubbed) ---
GEMINI_MODEL=gemini-3.1-flash-lite
VERTEX_AI_LOCATION=us-central1

# --- k6 engine ---
K6_IMAGE_TAG=grafana/k6:1.3.0         # TODO: bump to current pinned stable at build time
K6_JSONL_PATH=/tmp/k6.jsonl
SIDECAR_BATCH_SIZE=500
SIDECAR_FLUSH_INTERVAL_MS=1000
SIDECAR_SPOOL_DIR=/tmp/spool

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Testlyn
